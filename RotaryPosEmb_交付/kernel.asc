#include "acl/acl.h"
#include "kernel_operator.h"
#include <cmath>

/*
 * RotaryPosEmb 算子 —— Ascend C 原生实现（Vector Core / dav-2002 / Ascend 310P3）
 *
 * 核心公式（全部在 NPU 内核内实时计算，不预计算、不硬编码、不回传 CPU）：
 *   1) inv_freq[i] = 1 / theta^(2i/dim)，i = 0..dim/2-1   （匹配参考实现的 FP32 顺序）
 *   2) angle_i = p[b,s] * inv_freq[i]
 *   3) y[..., i]       = x[..., i]*cos(angle_i)       - x[..., i+dim/2]*sin(angle_i)
 *      y[..., i+dim/2] = x[..., i+dim/2]*cos(angle_i) + x[..., i]*sin(angle_i)
 *
 * 中间精度：inv_freq / angle / cos / sin 一律 FP32。
 *
 * 多核切分策略（按 B·S·H 三维分类，追求不同样例下最优并行度）：
 *   - token 维度 (B·S) 优先：cos/sin 每 token 算一次、跨 head 复用，效率最高。
 *   - head  维度 (H)   补充：token 不足时把 head 并行到多个核。
 *   - 二维 grid：block_idx = token_idx * head_split + head_idx。
 */

constexpr uint32_t BUFFER_NUM = 2;

struct RopeTilingData {
    uint32_t B, S, H, D;                 // 输入 size 信息
    uint32_t total_length_x;             // x 总长度（元素个数）
    uint32_t total_length_positions;     // positions 总长度（元素个数）
    uint32_t dtype;                      // 0=fp32, 1=fp16
    uint32_t block_dim;                  // 总核数 = token_split * head_split
    uint32_t token_split;                // token 维度切分份数
    uint32_t head_split;                 // head 维度切分份数
    uint32_t heads_per_core;             // 每核 head 数 = H / head_split
    uint32_t heads_per_tile;             // UB tile 的 head 数
    uint32_t tokens_per_tile;            // UB tile 的 token 数
    uint32_t head_groups_per_token;      // 每 token 拆几组（UB 切分）
    uint32_t half_d;                     // D / 2（inv_freq 元素个数）
    uint64_t inv_freq_gm_addr;           // host 预计算的 inv_freq 在 GM 上的地址（与 golden 逐位一致）
};

// T -> float（fp16 需 Cast 转 FP32，fp32 直接返回）
template <typename T>
__aicore__ inline AscendC::LocalTensor<float> cTtf(AscendC::LocalTensor<T>& src,
    AscendC::TBuf<AscendC::TPosition::VECCALC>& cast_buf, uint32_t count);
template <>
__aicore__ inline AscendC::LocalTensor<float> cTtf<half>(AscendC::LocalTensor<half>& src,
    AscendC::TBuf<AscendC::TPosition::VECCALC>& cast_buf, uint32_t count) {
    AscendC::LocalTensor<float> dst = cast_buf.template Get<float>();
    AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, count);
    return dst;
}
template <>
__aicore__ inline AscendC::LocalTensor<float> cTtf<float>(AscendC::LocalTensor<float>& src,
    AscendC::TBuf<AscendC::TPosition::VECCALC>& cast_buf, uint32_t count) {
    return src;
}

// float -> T
template <typename T>
__aicore__ inline void cftT(AscendC::LocalTensor<T>& dst, AscendC::LocalTensor<float>& src, uint32_t count);
template <>
__aicore__ inline void cftT<half>(AscendC::LocalTensor<half>& dst, AscendC::LocalTensor<float>& src, uint32_t count) {
    AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, count);
}
template <>
__aicore__ inline void cftT<float>(AscendC::LocalTensor<float>& dst, AscendC::LocalTensor<float>& src, uint32_t count) {
    (void)dst; (void)src; (void)count;
}

template <typename T>
class KernelRope {
public:
    __aicore__ inline KernelRope() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR positions, GM_ADDR y, float theta, RopeTilingData tiling) {
        this->H = tiling.H;
        this->D = tiling.D;
        this->theta = theta;
        this->head_split = tiling.head_split;
        this->token_split = tiling.token_split;
        this->heads_per_core = tiling.heads_per_core;
        this->heads_per_tile = tiling.heads_per_tile;
        this->tokens_per_tile = tiling.tokens_per_tile;
        this->head_groups_per_token = tiling.head_groups_per_token;
        this->total_tokens = tiling.total_length_positions;

        uint32_t block_idx = AscendC::GetBlockIdx();
        // 二维 grid 分解：block_idx = token_idx * head_split + head_idx
        uint32_t token_idx = block_idx / this->head_split;
        uint32_t head_idx  = block_idx % this->head_split;

        // token 范围（向上取整，余数 token 归前面的核）
        uint32_t tokens_per_core = (this->total_tokens + this->token_split - 1) / this->token_split;
        this->start_token = token_idx * tokens_per_core;
        this->end_token = this->start_token + tokens_per_core;
        if (this->end_token > this->total_tokens) this->end_token = this->total_tokens;
        if (this->start_token >= this->total_tokens) {
            this->start_token = this->total_tokens;
            this->end_token = this->total_tokens;
        }

        // head 范围（head_split 整除 H，均匀切分）
        this->my_head_start = head_idx * this->heads_per_core;
        this->my_heads = this->heads_per_core;

        // 只有 head 不切分时，token 内所有 head 才连续，可一次连续搬入
        this->is_full_head = (this->head_split == 1) && (this->heads_per_tile == this->my_heads);

        x_gm.SetGlobalBuffer((__gm__ T*)x, tiling.total_length_x);
        positions_gm.SetGlobalBuffer((__gm__ int32_t*)positions, tiling.total_length_positions);
        y_gm.SetGlobalBuffer((__gm__ T*)y, tiling.total_length_x);

        // L2 Cache bypass：x/y 均为流式访问（x 只读一次、y 只写一次），
        // 关闭 L2 缓存避免污染，提升访存带宽利用率。
        x_gm.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
        y_gm.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);

        uint32_t elem_per_32b = 32 / sizeof(T);
        this->per_token_stride = this->heads_per_tile * this->D;
        if (this->is_full_head) {
            this->per_token_padded = this->per_token_stride;
        } else {
            this->per_token_padded = ((this->per_token_stride + elem_per_32b - 1) / elem_per_32b) * elem_per_32b;
        }
        this->elems_per_tile = this->tokens_per_tile * this->per_token_padded;
        this->elems_per_tile = ((this->elems_per_tile + elem_per_32b - 1) / elem_per_32b) * elem_per_32b;

        pipe.InitBuffer(in_queue_x, BUFFER_NUM, this->elems_per_tile * sizeof(T));
        pipe.InitBuffer(out_queue_y, BUFFER_NUM, this->elems_per_tile * sizeof(T));

        if (sizeof(T) == 2) {
            pipe.InitBuffer(x_cast_buf, this->elems_per_tile * sizeof(float));
            pipe.InitBuffer(y_cast_buf, this->elems_per_tile * sizeof(float));
        }

        uint32_t pos_stride = ((this->tokens_per_tile + 7) / 8) * 8;
        pipe.InitBuffer(pos_tmp_buf, pos_stride * sizeof(int32_t));

        // inv_freq 由 Host 按 golden 表达式（1/powf(theta, 2i/D)）预计算，
        // 经 GM 传入。这是精度关键：Device 的 Power(exp·ln) 与 golden 的
        // fp32 powf 差 1 ULP，在大 position 时被放大导致精度失败。
        // Host 与 golden 共用同一 libm 的 std::pow，保证逐位一致。
        uint32_t inv_freq_stride = ((this->D / 2 + 7) / 8) * 8;
        pipe.InitBuffer(inv_freq, inv_freq_stride * sizeof(float));
        inv_freq_local = inv_freq.template Get<float>();

        // 从 GM 读取 inv_freq（host 已写好的 D/2 个 float，逐位匹配 golden）
        AscendC::GlobalTensor<float> inv_freq_gm;
        inv_freq_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(tiling.inv_freq_gm_addr), this->D / 2);
        uint32_t aligned_half = (this->D / 2 / 8) * 8;
        if (aligned_half > 0) {
            AscendC::DataCopy(inv_freq_local, inv_freq_gm, aligned_half);
        }
        for (uint32_t i = aligned_half; i < this->D / 2; i++) {
            inv_freq_local.SetValue(i, inv_freq_gm.GetValue(i));
        }
        for (uint32_t i = this->D / 2; i < inv_freq_stride; i++) {
            inv_freq_local.SetValue(i, 1.0f);
        }

        // cos/sin/angle 大小按 tokens_per_tile
        this->angle_stride = ((this->D / 2 + 7) / 8) * 8;
        uint32_t angle_total = this->tokens_per_tile * this->angle_stride;
        pipe.InitBuffer(cos, angle_total * sizeof(float));
        pipe.InitBuffer(sin, angle_total * sizeof(float));
        pipe.InitBuffer(angle, angle_total * sizeof(float));
        cos_local = cos.template Get<float>();
        sin_local = sin.template Get<float>();
        angle_local = angle.template Get<float>();

        uint32_t tmp_len = ((this->D / 2 + 7) / 8) * 8;
        pipe.InitBuffer(tmp_buf, tmp_len * sizeof(float));
        tmp = tmp_buf.template Get<float>();
    }

    __aicore__ inline void Process() {
        for (uint32_t token_base = this->start_token; token_base < this->end_token;
             token_base += this->tokens_per_tile) {
            uint32_t token_count = this->end_token - token_base;
            token_count = token_count > this->tokens_per_tile ? this->tokens_per_tile : token_count;

            // 小于 32B 时直接从 GM 各读取一次，既不越界，也不做多余 UB 中转。
            if (token_count >= 8) {
                CopyPositions(token_base, token_count);
            }
            ComputeCosSin(token_base, token_count);

            uint32_t G = this->head_groups_per_token;
            if (G == 1) {
                // 单 head group：顺序执行
                CopyIn(token_base, token_count, this->my_head_start, this->my_heads);
                Compute(token_count, this->my_heads);
                CopyOut(token_base, token_count, this->my_head_start, this->my_heads);
            } else {
                // 多 head group：乒乓双缓冲流水线，三引擎（MTE2/VEC/MTE3）重叠
                uint32_t g;
                for (g = 0; g < G && g < 2; g++) {
                    CopyIn(token_base, token_count, GetHeadStart(g), GetActualHeads(g));
                }
                for (g = 0; g < G; g++) {
                    Compute(token_count, GetActualHeads(g));
                    CopyOut(token_base, token_count, GetHeadStart(g), GetActualHeads(g));
                    if (g + 2 < G) {
                        CopyIn(token_base, token_count, GetHeadStart(g + 2), GetActualHeads(g + 2));
                    }
                }
            }
        }
    }

private:
    __aicore__ inline uint32_t GetHeadStart(uint32_t g) {
        return this->my_head_start + g * this->heads_per_tile;
    }
    __aicore__ inline uint32_t GetActualHeads(uint32_t g) {
        uint32_t actual = this->my_heads - g * this->heads_per_tile;
        return actual > this->heads_per_tile ? this->heads_per_tile : actual;
    }

    __aicore__ inline void CopyPositions(uint32_t token_base, uint32_t token_count) {
        AscendC::LocalTensor<int32_t> pos_local = pos_tmp_buf.template Get<int32_t>();
        // DataCopy 的长度必须按 32B 对齐，但不能因此越过 positions 的 GM 尾部。
        // 对齐主体走 MTE，最多 7 个 int32 尾元素走有边界的 Scalar 访问。
        uint32_t aligned_count = (token_count / 8) * 8;
        if (aligned_count > 0) {
            AscendC::DataCopy(pos_local, positions_gm[token_base], aligned_count);
        }
        for (uint32_t i = aligned_count; i < token_count; i++) {
            pos_local.SetValue(i, positions_gm.GetValue(token_base + i));
        }
    }

    __aicore__ inline void ComputeCosSin(uint32_t token_base, uint32_t token_count) {
        AscendC::LocalTensor<int32_t> pos_local = pos_tmp_buf.template Get<int32_t>();
        bool direct_position = token_count < 8;

        // angle[i] = p * inv_freq[i]（向量）
        for (uint32_t t = 0; t < token_count; t++) {
            float p = direct_position ? (float)positions_gm.GetValue(token_base + t)
                                      : (float)pos_local.GetValue(t);
            AscendC::Muls(angle_local[t * this->angle_stride], inv_freq_local, p, (int32_t)this->angle_stride);
        }

        // 向量 Cos/Sin：2002 架构（310P3）内部用 π_0..π_4 五段高精度归约，
        // 在 angle=131072 时归约误差仅 ~6.6e-9，远小于 atol 9.77e-4，无需手写标量归约。
        uint32_t angle_count = token_count * this->angle_stride;
        AscendC::Cos(cos_local, angle_local, angle_count);
        AscendC::Sin(sin_local, angle_local, angle_count);

        // positions=0 时 cos=1 sin=0（角度=0，向量 Cos/Sin 自然给出该结果；
        // 此处不做额外分支，避免与 golden 在 x 含 Inf 时的 NaN/Inf 语义不一致）
    }

    __aicore__ inline void CopyIn(uint32_t token_base, uint32_t token_count, uint32_t head_start,
                                  uint32_t actual_heads) {
        AscendC::LocalTensor<T> x_local = in_queue_x.AllocTensor<T>();
        uint32_t elem_per_32b = 32 / sizeof(T);

        if (this->is_full_head) {
            // head 未切分：token 内所有 head 连续，一次搬入
            uint64_t x_offset = (uint64_t)token_base * this->H * this->D;
            uint32_t valid_length = token_count * this->H * this->D;
            uint32_t aligned_length = (valid_length / elem_per_32b) * elem_per_32b;
            uint32_t tail_length = valid_length - aligned_length;

            if (aligned_length > 0) {
                AscendC::DataCopy(x_local, x_gm[x_offset], aligned_length);
            }
            for (uint32_t i = 0; i < tail_length; i++) {
                x_local.SetValue(aligned_length + i, x_gm.GetValue(x_offset + aligned_length + i));
            }
        } else {
            // head 可能切分：逐 token 搬入，每 token 搬 head_start 起始的连续 actual_heads 个 head
            uint32_t elems_per_head_group = actual_heads * this->D;
            uint32_t aligned_length = (elems_per_head_group / elem_per_32b) * elem_per_32b;
            uint32_t tail_length = elems_per_head_group - aligned_length;
            for (uint32_t t = 0; t < token_count; t++) {
                uint64_t x_offset = (uint64_t)(token_base + t) * this->H * this->D + (uint64_t)head_start * this->D;
                if (aligned_length > 0) {
                    AscendC::DataCopy(x_local[t * this->per_token_padded], x_gm[x_offset], aligned_length);
                }
                for (uint32_t i = 0; i < tail_length; i++) {
                    x_local.SetValue(t * this->per_token_padded + aligned_length + i,
                                     x_gm.GetValue(x_offset + aligned_length + i));
                }
            }
        }
        in_queue_x.EnQue<T>(x_local);
    }

    __aicore__ inline void Compute(uint32_t token_count, uint32_t actual_heads) {
        AscendC::LocalTensor<T> x_local_t = in_queue_x.DeQue<T>();
        AscendC::LocalTensor<T> y_local_t = out_queue_y.AllocTensor<T>();

        AscendC::LocalTensor<float> x_local_f = cTtf<T>(x_local_t, this->x_cast_buf, this->elems_per_tile);
        AscendC::LocalTensor<float> y_local_f = cTtf<T>(y_local_t, this->y_cast_buf, this->elems_per_tile);

        int32_t half_d = this->D / 2;

        if (half_d % 8 == 0) {
            for (uint32_t t = 0; t < token_count; t++) {
                uint32_t token_base_in_ub = t * this->per_token_padded;
                uint32_t angle_base = t * this->angle_stride;
                for (uint32_t h = 0; h < actual_heads; h++) {
                    uint32_t base = token_base_in_ub + h * this->D;
                    AscendC::LocalTensor<float> x0 = x_local_f[base];
                    AscendC::LocalTensor<float> x1 = x_local_f[base + this->D / 2];
                    AscendC::LocalTensor<float> y0 = y_local_f[base];
                    AscendC::LocalTensor<float> y1 = y_local_f[base + this->D / 2];
                    AscendC::LocalTensor<float> c = cos_local[angle_base];
                    AscendC::LocalTensor<float> s = sin_local[angle_base];

                    AscendC::Mul(y0, x0, c, half_d);
                    AscendC::Mul(tmp, x1, s, half_d);
                    AscendC::Sub(y0, y0, tmp, half_d);

                    AscendC::Mul(y1, x1, c, half_d);
                    AscendC::Mul(tmp, x0, s, half_d);
                    AscendC::Add(y1, y1, tmp, half_d);
                }
            }
        } else {
            for (uint32_t t = 0; t < token_count; t++) {
                uint32_t token_base_in_ub = t * this->per_token_padded;
                for (uint32_t h = 0; h < actual_heads; h++) {
                    uint32_t base = token_base_in_ub + h * this->D;
                    for (uint32_t i = 0; i < this->D / 2; i++) {
                        float x0 = x_local_f.GetValue(base + i);
                        float x1 = x_local_f.GetValue(base + this->D / 2 + i);
                        float c = cos_local.GetValue(t * this->angle_stride + i);
                        float s = sin_local.GetValue(t * this->angle_stride + i);
                        y_local_f.SetValue(base + i, x0 * c - x1 * s);
                        y_local_f.SetValue(base + this->D / 2 + i, x1 * c + x0 * s);
                    }
                }
            }
        }

        cftT<T>(y_local_t, y_local_f, this->elems_per_tile);

        in_queue_x.FreeTensor<T>(x_local_t);
        out_queue_y.EnQue<T>(y_local_t);
    }

    __aicore__ inline void CopyOut(uint32_t token_base, uint32_t token_count, uint32_t head_start,
                                   uint32_t actual_heads) {
        AscendC::LocalTensor<T> y_local = out_queue_y.DeQue<T>();
        uint32_t elem_per_32b = 32 / sizeof(T);

        if (this->is_full_head) {
            uint64_t y_offset = (uint64_t)token_base * this->H * this->D;
            uint32_t valid_len = token_count * this->H * this->D;
            uint32_t aligned_len = (valid_len / elem_per_32b) * elem_per_32b;
            uint32_t tail_len = valid_len - aligned_len;

            if (aligned_len > 0) {
                AscendC::DataCopy(y_gm[y_offset], y_local, aligned_len);
            }
            for (uint32_t i = 0; i < tail_len; i++) {
                y_gm.SetValue(y_offset + aligned_len + i, y_local.GetValue(aligned_len + i));
            }
        } else {
            uint32_t elems_per_head_group = actual_heads * this->D;
            uint32_t aligned_len = (elems_per_head_group / elem_per_32b) * elem_per_32b;
            uint32_t tail_len = elems_per_head_group - aligned_len;

            for (uint32_t t = 0; t < token_count; t++) {
                uint64_t y_offset = (uint64_t)(token_base + t) * this->H * this->D + (uint64_t)head_start * this->D;
                uint32_t ub_base = t * this->per_token_padded;
                if (aligned_len > 0) {
                    AscendC::DataCopy(y_gm[y_offset], y_local[ub_base], aligned_len);
                }
                for (uint32_t i = 0; i < tail_len; i++) {
                    y_gm.SetValue(y_offset + aligned_len + i, y_local.GetValue(ub_base + aligned_len + i));
                }
            }
        }
        out_queue_y.FreeTensor<T>(y_local);
    }

private:
    AscendC::TPipe pipe;
    uint32_t H, D;
    float theta;
    uint32_t heads_per_tile, tokens_per_tile, head_groups_per_token;
    uint32_t token_split, head_split, heads_per_core;
    uint32_t total_tokens, start_token, end_token;
    uint32_t my_head_start, my_heads;
    uint32_t per_token_stride;
    uint32_t per_token_padded;
    uint32_t elems_per_tile;
    uint32_t angle_stride;
    bool is_full_head;

    AscendC::GlobalTensor<T> x_gm, y_gm;
    AscendC::GlobalTensor<int32_t> positions_gm;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> in_queue_x;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> out_queue_y;
    AscendC::TBuf<AscendC::TPosition::VECCALC> x_cast_buf, y_cast_buf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> pos_tmp_buf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> inv_freq;
    AscendC::LocalTensor<float> inv_freq_local;
    AscendC::TBuf<AscendC::TPosition::VECCALC> cos, sin, angle;
    AscendC::LocalTensor<float> cos_local, sin_local, angle_local;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_buf;
    AscendC::LocalTensor<float> tmp;
};

__global__ __vector__ void rotary_pos_emb_custom(GM_ADDR x, GM_ADDR positions, GM_ADDR y, float theta,
                                                 RopeTilingData tiling) {
    if (tiling.dtype == 1) {
        KernelRope<half> op;
        op.Init(x, positions, y, theta, tiling);
        op.Process();
    } else {
        KernelRope<float> op;
        op.Init(x, positions, y, theta, tiling);
        op.Process();
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR positions,
                           const TensorGroupInfo& info_positions, GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t available_core_num, aclrtStream stream, float theta) {
    int64_t b64 = info_x.tensors[0].shape[0];
    int64_t s64 = info_x.tensors[0].shape[1];
    int64_t h64 = info_x.tensors[0].shape[2];
    int64_t d64 = info_x.tensors[0].shape[3];
    uint32_t dtype = info_x.tensors[0].dtype;

    // 本实现的 tiling 字段仍是 uint32_t；在转换前拒绝非法或溢出 shape。
    if (b64 <= 0 || s64 <= 0 || h64 <= 0 || d64 <= 0 || (d64 & 1) != 0 ||
        available_core_num <= 0 || (dtype != 0 && dtype != 1) ||
        !(theta > 0.0f) || !std::isfinite(theta)) {
        return;
    }
    uint64_t total_x64 = static_cast<uint64_t>(b64) * static_cast<uint64_t>(s64) *
                         static_cast<uint64_t>(h64) * static_cast<uint64_t>(d64);
    uint64_t total_pos64 = static_cast<uint64_t>(b64) * static_cast<uint64_t>(s64);
    if (total_x64 > 0xffffffffULL || total_pos64 > 0xffffffffULL) {
        return;
    }

    uint32_t B = static_cast<uint32_t>(b64);
    uint32_t S = static_cast<uint32_t>(s64);
    uint32_t H = static_cast<uint32_t>(h64);
    uint32_t D = static_cast<uint32_t>(d64);
    uint32_t total_length_x = static_cast<uint32_t>(total_x64);
    uint32_t total_length_positions = static_cast<uint32_t>(total_pos64);

    uint32_t C = (uint32_t)available_core_num;

    // ===== 多核二维切分决策（token × head）=====
    // 优先 token 并行（cos/sin 跨 head 复用，效率最高）；
    // token 不足时用 head 维度补，head_split 需整除 H（保证 head 均匀切分）。
    uint32_t token_split, head_split;
    if (total_length_positions >= C) {
        token_split = C;         // token 充足，纯 token 切分
        head_split = 1;
    } else {
        token_split = total_length_positions;   // token 不足时再考虑沿 head 补并行度
        head_split = C / token_split;
        if (head_split > H) head_split = H;
        while (H % head_split != 0 && head_split > 1) head_split--;
        if (head_split < 1) head_split = 1;
    }
    uint32_t block_dim = token_split * head_split;
    uint32_t heads_per_core = H / head_split;

    // ===== 核内 UB 切分（精确覆盖所有实际 TPipe Buffer）=====
    constexpr uint32_t UB_BUDGET = 100 * 1024;
    uint32_t dtype_size = (dtype == 1) ? 2 : 4;
    uint32_t per_elem = 2 * dtype_size * BUFFER_NUM;
    if (dtype == 1) per_elem += 2 * sizeof(float);

    uint32_t angle_stride = ((D / 2 + 7) / 8) * 8;
    uint32_t tokens_per_core = (total_length_positions + token_split - 1) / token_split;
    uint32_t elem_per_32b = 32 / dtype_size;

    // 固定区：inv_freq、tmp（各 angle_stride 个 float）。
    uint64_t fixed_bytes = 2ULL * angle_stride * sizeof(float);
    // 每 token：cos、sin、angle；positions 另按 32B 对齐计算。
    uint64_t angle_bytes_per_token = 3ULL * angle_stride * sizeof(float);

    auto TileBytes = [&](uint32_t heads, uint32_t tokens) -> uint64_t {
        uint64_t raw_elems = static_cast<uint64_t>(heads) * D;
        uint64_t padded_elems = ((raw_elems + elem_per_32b - 1) / elem_per_32b) * elem_per_32b;
        uint64_t data_bytes = static_cast<uint64_t>(tokens) * padded_elems * per_elem;
        uint64_t angle_bytes = static_cast<uint64_t>(tokens) * angle_bytes_per_token;
        uint64_t pos_bytes = static_cast<uint64_t>(((tokens + 7) / 8) * 8) * sizeof(int32_t);
        return fixed_bytes + data_bytes + angle_bytes + pos_bytes;
    };

    uint32_t heads_per_tile = heads_per_core;
    uint32_t tokens_per_tile = 1;
    uint32_t head_groups_per_token = 1;

    if (TileBytes(heads_per_core, 1) <= UB_BUDGET) {
        // 先用保守公式给出上界，再用完整公式收紧，避免大 token 数线性试探。
        uint64_t padded_elems =
            ((static_cast<uint64_t>(heads_per_core) * D + elem_per_32b - 1) / elem_per_32b) * elem_per_32b;
        uint64_t approx_per_token = padded_elems * per_elem + angle_bytes_per_token + sizeof(int32_t);
        uint64_t usable = UB_BUDGET > fixed_bytes + 28 ? UB_BUDGET - fixed_bytes - 28 : 0;
        uint64_t approx_tokens = approx_per_token == 0 ? 1 : usable / approx_per_token;
        if (approx_tokens < 1) approx_tokens = 1;
        tokens_per_tile = static_cast<uint32_t>(
            approx_tokens > tokens_per_core ? tokens_per_core : approx_tokens);
        while (tokens_per_tile > 1 && TileBytes(heads_per_core, tokens_per_tile) > UB_BUDGET) {
            tokens_per_tile--;
        }
    } else {
        // 单 token 放不下全部 head 时，寻找能够安全放入 UB 的最大 head group。
        while (heads_per_tile > 1 && TileBytes(heads_per_tile, 1) > UB_BUDGET) {
            heads_per_tile--;
        }
        if (TileBytes(heads_per_tile, 1) > UB_BUDGET) {
            return;
        }
        head_groups_per_token = (heads_per_core + heads_per_tile - 1) / heads_per_tile;
    }

    RopeTilingData tiling;
    tiling.B = B;
    tiling.S = S;
    tiling.H = H;
    tiling.D = D;
    tiling.total_length_x = total_length_x;
    tiling.total_length_positions = total_length_positions;
    tiling.dtype = dtype;
    tiling.block_dim = block_dim;
    tiling.token_split = token_split;
    tiling.head_split = head_split;
    tiling.heads_per_core = heads_per_core;
    tiling.heads_per_tile = heads_per_tile;
    tiling.tokens_per_tile = tokens_per_tile;
    tiling.head_groups_per_token = head_groups_per_token;
    tiling.half_d = D / 2;

    // inv_freq 在 host 侧用 std::pow 计算（与 golden 共用同一 libm，逐位一致），
    // 写入一块临时 GM 缓冲，通过 tiling.inv_freq_gm_addr 传给 kernel。
    // 这是精度关键：Device 的 Power(exp·ln) 与 golden 的 fp32 powf 差 1 ULP，
    // 在大 position 时被放大导致精度失败。
    uint32_t inv_freq_count = D / 2;
    size_t inv_freq_bytes = (size_t)inv_freq_count * sizeof(float);
    float* inv_freq_host = nullptr;
    void* inv_freq_dev = nullptr;
    if (aclrtMallocHost((void**)(&inv_freq_host), inv_freq_bytes) != 0 ||
        aclrtMalloc(&inv_freq_dev, inv_freq_bytes, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
        return;
    }
    for (uint32_t i = 0; i < inv_freq_count; i++) {
        float exponent = static_cast<float>(2U * i) / static_cast<float>(D);
        inv_freq_host[i] = 1.0f / std::pow(theta, exponent);
    }
    if (aclrtMemcpy(inv_freq_dev, inv_freq_bytes, inv_freq_host, inv_freq_bytes,
                    ACL_MEMCPY_HOST_TO_DEVICE) != 0) {
        aclrtFree(inv_freq_dev);
        aclrtFreeHost(inv_freq_host);
        return;
    }
    tiling.inv_freq_gm_addr = reinterpret_cast<uint64_t>(inv_freq_dev);

    rotary_pos_emb_custom<<<block_dim, nullptr, stream>>>(x, positions, y, theta, tiling);

    // 等待 kernel 完成后释放临时 inv_freq GM 缓冲
    aclrtSynchronizeStream(stream);
    aclrtFree(inv_freq_dev);
    aclrtFreeHost(inv_freq_host);
}
